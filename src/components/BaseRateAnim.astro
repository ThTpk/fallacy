---
// Mounted only on /fallacy/base-rate-neglect.
---

<figure class="anim">
  <div id="baserate-stage"></div>
  <figcaption>
    หนึ่งจุดคือหนึ่งคนที่ผลตรวจเป็นบวก กองขวาคือผลบวกลวง ซึ่งมากกว่ากองซ้ายสิบเท่าทั้งที่ชุดตรวจแม่น 99% จริง
  </figcaption>
</figure>

<style>
  .anim { margin: 20px 0; }
  .anim > div { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; line-height: 0; background: var(--surface); --lamp: #c98b2a; }
  @media (prefers-color-scheme: dark) {
    .anim > div { --lamp: #e0ad55; }
  }
  .anim svg { display: block; width: 100%; height: auto; color: var(--text); }
  .anim :global(.pp) { fill: var(--surface); }
  .anim :global(.br-t) { font-family: 'Noto Sans Thai', system-ui, sans-serif; }
  .anim figcaption { color: var(--muted); font-size: 0.9rem; margin-top: 6px; line-height: 1.6; }
</style>

<script>
  import '../anim/base-rate-neglect.ts';
</script>
