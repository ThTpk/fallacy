<figure class="anim">
  <div id="regression-stage"></div>
  <figcaption>
    เส้นทึบคือกลุ่มที่ได้รับการรักษา เส้นประคือกลุ่มที่ไม่ได้ทำอะไรเลย ทั้งคู่ตกพร้อมกันและขึ้นมาพอกัน
  </figcaption>
</figure>

<style>
  .anim { margin: 20px 0; }
  .anim > div { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; line-height: 0; background: var(--surface); --lamp: #c98b2a; }
  @media (prefers-color-scheme: dark) {
    .anim > div { --lamp: #e0ad55; }
  }
  .anim svg { display: block; width: 100%; height: auto; color: var(--text); }
  .anim :global(.pp) { fill: var(--surface); }
  .anim :global(.rg-t) { font-family: 'Noto Sans Thai', system-ui, sans-serif; }
  .anim figcaption { color: var(--muted); font-size: 0.9rem; margin-top: 6px; line-height: 1.6; }
</style>

<script>
  import '../anim/regression-to-the-mean.ts';
</script>
