---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600&display=swap"
    />
    <style is:global>
      :root {
        --bg: #fbfaf7;
        --surface: #ffffff;
        --text: #22211f;
        --muted: #5f5e59;
        --line: #d8d5cc;
        --accent: #1d5f8a;
        --bad: #b03a36;
        --ok: #2f6d4f;
        --box: #f3f1ea;
        --hl-bg: #fdf0d8;
        --hl: #a9741a;
        --radius: 10px;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #16150f;
          --surface: #1e1d17;
          --text: #e8e5da;
          --muted: #a5a299;
          --line: #3a382f;
          --accent: #7fb6dd;
          --bad: #e08b87;
          --ok: #86c4a2;
          --box: #272619;
          --hl-bg: #35290f;
          --hl: #e0ad55;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: 'Noto Sans Thai', 'IBM Plex Sans Thai', system-ui, sans-serif;
        font-size: 17px;
        line-height: 1.75;
      }
      main { max-width: 760px; margin: 0 auto; padding: 32px 16px 80px; }
      a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 2px; }
      h1 { font-size: 1.7rem; font-weight: 600; line-height: 1.35; margin: 0 0 4px; }
      h2 { font-size: 1.15rem; font-weight: 600; margin: 36px 0 10px; }
      h3 { font-size: 1rem; font-weight: 600; margin: 24px 0 6px; }
      code, .mono { font-family: ui-monospace, 'Cascadia Code', monospace; font-size: 0.92em; }
      header.site { border-bottom: 1px solid var(--line); background: var(--surface); }
      header.site div { max-width: 760px; margin: 0 auto; padding: 14px 16px; display: flex; gap: 16px; align-items: baseline; }
      header.site strong { font-weight: 600; }
      .sub { color: var(--muted); font-size: 0.95rem; }
      .en { color: var(--muted); font-weight: 400; font-size: 0.95rem; }
      .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 16px 18px;
        margin: 14px 0;
      }
      .form {
        background: var(--box);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 12px 16px;
        font-family: ui-monospace, 'Cascadia Code', monospace;
        font-size: 0.95rem;
      }
      .tag {
        display: inline-block;
        font-size: 0.78rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 1px 10px;
        color: var(--muted);
        background: var(--box);
      }
      .lvl { font-size: 0.78rem; color: var(--muted); letter-spacing: 0.02em; }
      ul.plain { list-style: none; padding: 0; }
      ul.plain li { margin: 6px 0; }
      blockquote {
        margin: 0;
        padding: 2px 0 2px 16px;
        border-left: 3px solid var(--line);
        border-radius: 0;
      }
      .ok { color: var(--ok); }
      .bad { color: var(--bad); }
      figure { margin: 18px 0; }
      figcaption { color: var(--muted); font-size: 0.9rem; margin-top: 2px; }
      svg.dg { width: 100%; height: auto; display: block; }
      svg.dg text { font-family: 'Noto Sans Thai', system-ui, sans-serif; }
      .grid { display: grid; gap: 10px; }
      @media (min-width: 620px) { .grid.two { grid-template-columns: 1fr 1fr; } }
      footer.site { border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; }
      footer.site div { max-width: 760px; margin: 0 auto; padding: 20px 16px 40px; }
    </style>
  </head>
  <body>
    <header class="site">
      <div>
        <strong><a href="/" style="text-decoration:none;color:inherit">ตรรกวิบัติ</a></strong>
        <span class="sub">คลังตรรกวิบัติและเคสจริง</span>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div>
        เนื้อหาเพื่อการศึกษา ทุกเคสยกคำพูดตรงตัวพร้อมระบุแหล่งที่มาและวันที่เปิดดู
        การพบตรรกวิบัติหมายความว่าข้อสรุปยังไม่ได้รับการสนับสนุน ไม่ได้หมายความว่าข้อสรุปเป็นเท็จ
      </div>
    </footer>
  </body>
</html>
