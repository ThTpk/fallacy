---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CategoryTree from '../components/CategoryTree.astro';
import HomeShelf from '../components/HomeShelf.astro';
import { CATEGORY_TH, CATEGORY_ORDER, dots, thDate, url } from '../lib/text';

const fallacies = await getCollection('fallacies');
const cases = await getCollection('cases');
const comparisons = await getCollection('comparisons');
const foundations = (await getCollection('foundations')).sort(
  (a, b) => a.data.order - b.data.order,
);

const byCategory = CATEGORY_ORDER.map((c) => ({
  id: c,
  name: CATEGORY_TH[c],
  items: fallacies
    .filter((f) => f.data.category === c)
    .sort((a, b) => a.data.difficulty - b.data.difficulty || a.data.name_th.localeCompare(b.data.name_th, 'th')),
})).filter((g) => g.items.length > 0);

const caseCount = (slug: string) =>
  cases.filter((c) => c.data.fallacies.some((f) => f.slug.id === slug)).length;
---

<Base
  title="ตรรกวิบัติ — คลังตรรกวิบัติและเคสจริง"
  description={`คลังตรรกวิบัติ ${fallacies.length} รายการ พร้อมแผนภาพอธิบายว่าตรรกะผิดตรงไหน และเคสจริง ${cases.length} เคสที่ระบุแหล่งที่มา`}
>
  <HomeShelf />
  <h1>ตรรกวิบัติ</h1>
  <p class="sub">
    ตรรกวิบัติ {fallacies.length} รายการ และเคสจริง {cases.length} เคส
    ทุกรายการมีแผนภาพที่สร้างจากโครงของข้อโต้แย้งเอง และมีช่องบอกกรณีที่คล้ายกันแต่ใช้ได้
  </p>

  <div class="card">
    <strong>อ่านก่อนใช้</strong>
    <p style="margin:6px 0 0">
      การพบตรรกวิบัติบอกได้เพียงว่าข้อสรุปนั้น <em>ยังไม่ได้รับการสนับสนุน</em>
      ไม่ได้บอกว่าข้อสรุปเป็นเท็จ การสรุปว่าเป็นเท็จคือ
      <a href={url('fallacy/fallacy-fallacy')}>ตรรกวิบัติของการจับตรรกวิบัติ</a> เสียเอง
    </p>
  </div>

  <section>
    <h2>ภาพรวมทั้งคลัง <span class="en">{fallacies.length} รายการ</span></h2>
    <p class="sub" style="margin-top:0">
      หมวดหมู่ไม่ได้เรียงกันเฉย ๆ แต่แตกออกจากคำถามว่าข้อโต้แย้งพังตรงไหน
      กดดูทีละกิ่งจะเห็นว่าแต่ละหมวดตอบคำถามคนละข้อ
    </p>
    <CategoryTree />
  </section>

  <section>
    <h2>เริ่มที่นี่ <span class="en">พื้นฐาน {foundations.length} หน้า</span></h2>
    <p class="sub" style="margin-top:0">
      อ่านส่วนนี้ก่อนจะได้ประโยชน์จากคลังมากกว่าการไล่อ่านรายชื่อตรรกวิบัติ
      เพราะเกือบทุกหน้าในคลังอ้างถึงแนวคิดในนี้
    </p>
    <ol>
      {foundations.map((f) => (
        <li style="margin:8px 0">
          <a href={url(`foundations/${f.id}`)} style="font-weight:500">{f.data.title_th}</a>
          <div class="sub">{f.data.one_liner}</div>
        </li>
      ))}
    </ol>
  </section>

  {byCategory.map((g) => (
    <section>
      <h2>{g.name} <span class="en">{g.items.length} รายการ</span></h2>
      <div class="grid">
        {g.items.map((f) => (
          <a href={url(`fallacy/${f.id}`)} class="card" style="text-decoration:none;color:inherit;display:block">
            <div style="display:flex;justify-content:space-between;gap:12px;align-items:baseline">
              <strong>{f.data.name_th}</strong>
              <span class="lvl">{dots(f.data.difficulty)}</span>
            </div>
            <div class="en">{f.data.name_en}</div>
            <div style="margin-top:6px">{f.data.one_liner}</div>
            {caseCount(f.id) > 0 && (
              <div style="margin-top:8px"><span class="tag">เคสจริง {caseCount(f.id)} เคส</span></div>
            )}
          </a>
        ))}
      </div>
    </section>
  ))}

  <section>
    <h2>เทียบคู่ที่สับสนบ่อย <span class="en">{comparisons.length} คู่</span></h2>
    <p class="sub" style="margin-top:0">
      แต่ละหน้ามีคำถามเดียวที่ใช้แยกคู่นั้นออกจากกัน พร้อมตัวอย่างของทั้งสองฝั่ง
    </p>
    <ul class="plain">
      {comparisons
        .map((c) => ({
          c,
          a: fallacies.find((f) => f.id === c.data.a.id)!,
          b: fallacies.find((f) => f.id === c.data.b.id)!,
        }))
        .sort((x, y) => x.a.data.name_th.localeCompare(y.a.data.name_th, 'th'))
        .map(({ c, a, b }) => (
          <li class="card">
            <a href={url(`compare/${c.id}`)} style="font-weight:500">
              {a.data.name_th} หรือ {b.data.name_th}
            </a>
            <div class="sub">{c.data.question}</div>
          </li>
        ))}
    </ul>
  </section>

  <section>
    <h2>เคสจริง <span class="en">{cases.length} เคส</span></h2>
    <p class="sub" style="margin-top:0">
      ทุกเคสยกคำพูดตรงตัว ระบุสื่อ วันเผยแพร่ และวันที่เปิดดูหน้าต้นทาง
      และมีช่องการตีความอย่างเมตตาที่สุดกับช่องสิ่งที่ไม่ได้กล่าวอ้าง
    </p>
    <ul class="plain">
      {cases
        .sort((a, b) => b.data.date_of_statement.getTime() - a.data.date_of_statement.getTime())
        .map((c) => (
          <li class="card">
            <a href={url(`case/${c.id}`)} style="font-weight:500">{c.data.title_th}</a>
            <div class="sub">
              {c.data.source.outlet} · {thDate(c.data.date_of_statement)}
            </div>
          </li>
        ))}
    </ul>
  </section>
</Base>
