---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  CASE_STATUS_TH,
  DOMAIN_TH,
  MEDIUM_TH,
  SENSITIVITY_TH,
  paras,
  thDate,
  url,
} from '../../lib/text';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  const fallacies = await getCollection('fallacies');
  return cases.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, fallacies },
  }));
}

const { entry, fallacies } = Astro.props;
const c = entry.data;
const byId = new Map(fallacies.map((f) => [f.id, f]));

// Every long field in a case is a YAML folded scalar, so paragraph breaks
// survive as single newlines and have to be recovered. Before this was done
// here, a 5,000-character context rendered as one unbroken block, which is
// the shape nobody reads. See paras() for why mdLite cannot do this job.
const P = (s: string) => paras(s).map((t, i) => ({ t, first: i === 0 }));
---

<Base title={`${c.title_th} — เคสจริง`} description={c.plain ?? c.quote}>
  <p class="sub" style="margin:0"><a href={url('/')}>กลับหน้ารวม</a></p>
  <h1>{c.title_th}</h1>
  <p>
    <span class="tag">{c.case_kind === 'pattern' ? 'รูปแบบที่แหล่งข้อมูลรายงาน' : 'คำพูดเฉพาะ'}</span>
    <span class="tag">{MEDIUM_TH[c.source.medium]}</span>
    <span class="tag">สถานะ {CASE_STATUS_TH[c.status]}</span>
  </p>

  {c.status === 'retracted' && c.retraction_note && (
    <div class="card" style="border-color:var(--bad)">
      <strong class="bad">เคสนี้ถูกถอน</strong>
      <p style="margin:6px 0 0">{c.retraction_note}</p>
    </div>
  )}

  {/* The short version comes first, before the quotation and the citation
      apparatus. A reader who stops here should still leave with the point. */}
  {c.plain && (
    <div class="card plainbox">
      <div class="sub" style="margin-bottom:6px">อ่านแบบสั้น</div>
      {P(c.plain).map((p) => (
        <p style={p.first ? 'margin:0' : 'margin:8px 0 0'}>{p.t}</p>
      ))}
    </div>
  )}

  <h2>ข้อความที่ยกมา</h2>
  <div class="card">
    <blockquote style="font-size:1.08rem">{c.quote}</blockquote>
    <div class="sub" style="margin-top:10px">ยกมาตรงตัว · {c.quote_lang === 'th' ? 'ภาษาไทย' : 'ภาษาอังกฤษ'}</div>
  </div>

  <h3>บริบท</h3>
  {P(c.context).map((p) => (
    <p style={p.first ? 'margin:0' : 'margin:10px 0 0'}>{p.t}</p>
  ))}
  <p class="sub">ผู้พูดหรือที่มาของข้อความ: {c.speaker_role}{c.speaker_name && ` (${c.speaker_name})`}</p>

  <h2>การวิเคราะห์</h2>
  {c.fallacies.map((f) => {
    const fa = byId.get(f.slug.id);
    return (
      <div class="card">
        <div style="display:flex;justify-content:space-between;gap:12px;align-items:baseline">
          <strong>
            {fa ? <a href={url(`fallacy/${fa.id}`)}>{fa.data.name_th}</a> : f.slug.id}
          </strong>
          <span class="tag">{f.confidence === 'clear' ? 'ชัดเจน' : 'ยังเถียงได้'}</span>
        </div>
        {fa && <div class="en">{fa.data.name_en}</div>}
        {P(f.analysis).map((p) => (
          <p style={p.first ? 'margin:8px 0 0' : 'margin:10px 0 0'}>{p.t}</p>
        ))}
      </div>
    );
  })}

  {/* The same error written in the notation of logic or arithmetic. It sits
      after the analysis because it is a second pass over the same ground for
      a reader who wants it, not a prerequisite for the first pass. */}
  {c.formal && (
    <>
      <h2>เทียบกับคณิตศาสตร์และตรรกศาสตร์</h2>
      <div class="card formalbox">
        {P(c.formal).map((p) => (
          <p style={p.first ? 'margin:0' : 'margin:10px 0 0'}>{p.t}</p>
        ))}
      </div>
    </>
  )}

  <h2>การตีความอย่างเมตตาที่สุด</h2>
  {P(c.charitable_reading).map((p) => (
    <p style={p.first ? 'margin:0' : 'margin:10px 0 0'}>{p.t}</p>
  ))}

  <h2>สิ่งที่เคสนี้ไม่ได้กล่าวอ้าง</h2>
  <div class="card" style="border-color:var(--accent)">
    {P(c.not_claiming).map((p) => (
      <p style={p.first ? 'margin:0' : 'margin:10px 0 0'}>{p.t}</p>
    ))}
  </div>

  <h2>แหล่งที่มา</h2>
  <div class="card">
    <div><strong>{c.source.outlet}</strong></div>
    <div style="margin-top:4px">{c.source.headline}</div>
    {c.source.author && <div class="sub">โดย {c.source.author}</div>}
    <div class="sub" style="margin-top:8px">
      เผยแพร่ {thDate(c.source.published)} · เปิดดูเมื่อ {thDate(c.source.accessed)}
    </div>
    <div style="margin-top:8px"><a href={c.source.url}>เปิดหน้าต้นทาง</a></div>
  </div>

  {c.corroboration.length > 0 && (
    <>
      <h3>แหล่งยืนยันเพิ่ม</h3>
      <ul class="plain">
        {c.corroboration.map((x) => (
          <li><a href={x.url}>{x.outlet}</a></li>
        ))}
      </ul>
    </>
  )}

  {c.verification_notes && (
    <>
      <h3>บันทึกการตรวจสอบ</h3>
      {P(c.verification_notes).map((p) => (
        <p class="sub" style={p.first ? 'margin:0' : 'margin:8px 0 0'}>{p.t}</p>
      ))}
    </>
  )}

  <p class="sub">
    หมวด {DOMAIN_TH[c.domain]} · ระดับความละเอียดอ่อน {SENSITIVITY_TH[c.sensitivity]} ·
    ตรวจโดย {c.reviewed_by.join(', ')} ·
    ปรับปรุงล่าสุด {thDate(c.updated)}
  </p>
</Base>

<style>
  /* The short version has to look like the place to start, not like one more
     card among many, so it carries a tint as well as a bar. */
  .plainbox {
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
  }
  .plainbox p { font-size: 1.04rem; }
  .formalbox { border-left: 3px solid var(--muted); }
</style>
