---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Diagram from '../../components/Diagram.astro';
import PostHocAnim from '../../components/PostHocAnim.astro';
import BandwagonAnim from '../../components/BandwagonAnim.astro';
import StrawManAnim from '../../components/StrawManAnim.astro';
import SurvivorshipAnim from '../../components/SurvivorshipAnim.astro';
import SlipperySlopeAnim from '../../components/SlipperySlopeAnim.astro';
import FalseDilemmaAnim from '../../components/FalseDilemmaAnim.astro';
import CumHocAnim from '../../components/CumHocAnim.astro';
import IgnoranceAnim from '../../components/IgnoranceAnim.astro';
import AdHominemAnim from '../../components/AdHominemAnim.astro';
import ScotsmanAnim from '../../components/ScotsmanAnim.astro';
import HastyAnim from '../../components/HastyAnim.astro';
import CompositionAnim from '../../components/CompositionAnim.astro';
import DivisionAnim from '../../components/DivisionAnim.astro';
import TwoWrongsAnim from '../../components/TwoWrongsAnim.astro';
import ElenchiAnim from '../../components/ElenchiAnim.astro';
import AccidentAnim from '../../components/AccidentAnim.astro';
import BeggingAnim from '../../components/BeggingAnim.astro';
import AnalogyAnim from '../../components/AnalogyAnim.astro';
import AuthorityAnim from '../../components/AuthorityAnim.astro';
import FallacyFallacyAnim from '../../components/FallacyFallacyAnim.astro';
import AmphibolyAnim from '../../components/AmphibolyAnim.astro';
import MiddleAnim from '../../components/MiddleAnim.astro';
import GallopAnim from '../../components/GallopAnim.astro';
import MotteAnim from '../../components/MotteAnim.astro';
import GoalpostsAnim from '../../components/GoalpostsAnim.astro';
import WellAnim from '../../components/WellAnim.astro';
import WhataboutAnim from '../../components/WhataboutAnim.astro';
import ConsequentAnim from '../../components/ConsequentAnim.astro';
import AntecedentAnim from '../../components/AntecedentAnim.astro';
import EquivocationAnim from '../../components/EquivocationAnim.astro';
import LoadedAnim from '../../components/LoadedAnim.astro';
import CelebrityAnim from '../../components/CelebrityAnim.astro';
import PityAnim from '../../components/PityAnim.astro';
import ReverseAnim from '../../components/ReverseAnim.astro';
import BaseRateAnim from '../../components/BaseRateAnim.astro';
import RiskAnim from '../../components/RiskAnim.astro';
import RegressionAnim from '../../components/RegressionAnim.astro';
import SharpshooterAnim from '../../components/SharpshooterAnim.astro';
import SelectionAnim from '../../components/SelectionAnim.astro';
import NatureAnim from '../../components/NatureAnim.astro';
import TraditionAnim from '../../components/TraditionAnim.astro';
import NoveltyAnim from '../../components/NoveltyAnim.astro';
import FearAnim from '../../components/FearAnim.astro';
import CherryAnim from '../../components/CherryAnim.astro';
import ContextAnim from '../../components/ContextAnim.astro';
import ModerationAnim from '../../components/ModerationAnim.astro';
import NirvanaAnim from '../../components/NirvanaAnim.astro';
import SunkAnim from '../../components/SunkAnim.astro';
import PleadingAnim from '../../components/PleadingAnim.astro';
import GamblerAnim from '../../components/GamblerAnim.astro';
import EcologicalAnim from '../../components/EcologicalAnim.astro';
import { mdLite, CATEGORY_TH, KIND_TH, LEVEL_TH, dots, thDate, url } from '../../lib/text';

export async function getStaticPaths() {
  const fallacies = await getCollection('fallacies');
  const cases = await getCollection('cases');
  return fallacies.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, fallacies, cases },
  }));
}

const { entry, fallacies, cases } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const byId = new Map(fallacies.map((f) => [f.id, f]));
const resolve = (refs: { id: string }[]) =>
  refs.map((r) => byId.get(r.id)).filter((f): f is NonNullable<typeof f> => Boolean(f));

const confused = resolve(d.confused_with);
const related = resolve(d.related);
const linkedCases = cases.filter((c) => c.data.fallacies.some((f) => f.slug.id === entry.id));
const order = { clear: 0, everyday: 1, subtle: 2 } as const;
const examples = [...d.examples].sort((a, b) => order[a.level] - order[b.level]);
---

<Base title={`${d.name_th} (${d.name_en}) — ตรรกวิบัติ`} description={d.one_liner}>
  <p class="sub" style="margin:0"><a href={url('/')}>กลับหน้ารวม</a></p>
  <h1>{d.name_th}</h1>
  <p class="en" style="margin:0 0 10px">
    {d.name_en}{d.name_la && <> · <em>{d.name_la}</em></>}
  </p>
  <p>
    <span class="tag">{CATEGORY_TH[d.category]}</span>
    {/* for the rhetorical category the two labels say the same thing */}
    {KIND_TH[d.kind] !== CATEGORY_TH[d.category] && <span class="tag">{KIND_TH[d.kind]}</span>}
    <span class="tag">ความยาก {dots(d.difficulty)}</span>
  </p>

  <p style="font-size:1.1rem">{d.one_liner}</p>

  {d.form && <div class="form">{d.form}</div>}

  {d.diagram && <Diagram d={d.diagram} />}

  {entry.id === 'post-hoc' && <PostHocAnim />}
  {entry.id === 'bandwagon' && <BandwagonAnim />}
  {entry.id === 'straw-man' && <StrawManAnim />}
  {entry.id === 'survivorship-bias' && <SurvivorshipAnim />}
  {entry.id === 'slippery-slope' && <SlipperySlopeAnim />}
  {entry.id === 'false-dilemma' && <FalseDilemmaAnim />}
  {entry.id === 'cum-hoc' && <CumHocAnim />}
  {entry.id === 'appeal-to-ignorance' && <IgnoranceAnim />}
  {entry.id === 'ad-hominem' && <AdHominemAnim />}
  {entry.id === 'no-true-scotsman' && <ScotsmanAnim />}
  {entry.id === 'hasty-generalization' && <HastyAnim />}
  {entry.id === 'composition' && <CompositionAnim />}
  {entry.id === 'division' && <DivisionAnim />}
  {entry.id === 'two-wrongs' && <TwoWrongsAnim />}
  {entry.id === 'ignoratio-elenchi' && <ElenchiAnim />}
  {entry.id === 'accident' && <AccidentAnim />}
  {entry.id === 'begging-the-question' && <BeggingAnim />}
  {entry.id === 'faulty-analogy' && <AnalogyAnim />}
  {entry.id === 'appeal-to-authority' && <AuthorityAnim />}
  {entry.id === 'fallacy-fallacy' && <FallacyFallacyAnim />}
  {entry.id === 'amphiboly' && <AmphibolyAnim />}
  {entry.id === 'undistributed-middle' && <MiddleAnim />}
  {entry.id === 'gish-gallop' && <GallopAnim />}
  {entry.id === 'motte-and-bailey' && <MotteAnim />}
  {entry.id === 'moving-the-goalposts' && <GoalpostsAnim />}
  {entry.id === 'poisoning-the-well' && <WellAnim />}
  {entry.id === 'whataboutism' && <WhataboutAnim />}
  {entry.id === 'affirming-the-consequent' && <ConsequentAnim />}
  {entry.id === 'denying-the-antecedent' && <AntecedentAnim />}
  {entry.id === 'equivocation' && <EquivocationAnim />}
  {entry.id === 'loaded-question' && <LoadedAnim />}
  {entry.id === 'appeal-to-celebrity' && <CelebrityAnim />}
  {entry.id === 'appeal-to-pity' && <PityAnim />}
  {entry.id === 'reverse-causation' && <ReverseAnim />}
  {entry.id === 'base-rate-neglect' && <BaseRateAnim />}
  {entry.id === 'relative-risk' && <RiskAnim />}
  {entry.id === 'regression-to-the-mean' && <RegressionAnim />}
  {entry.id === 'texas-sharpshooter' && <SharpshooterAnim />}
  {entry.id === 'self-selection' && <SelectionAnim />}
  {entry.id === 'appeal-to-nature' && <NatureAnim />}
  {entry.id === 'appeal-to-tradition' && <TraditionAnim />}
  {entry.id === 'appeal-to-novelty' && <NoveltyAnim />}
  {entry.id === 'appeal-to-fear' && <FearAnim />}
  {entry.id === 'cherry-picking' && <CherryAnim />}
  {entry.id === 'quoting-out-of-context' && <ContextAnim />}
  {entry.id === 'middle-ground' && <ModerationAnim />}
  {entry.id === 'nirvana-fallacy' && <NirvanaAnim />}
  {entry.id === 'sunk-cost' && <SunkAnim />}
  {entry.id === 'special-pleading' && <PleadingAnim />}
  {entry.id === 'gamblers-fallacy' && <GamblerAnim />}
  {entry.id === 'ecological-fallacy' && <EcologicalAnim />}

  <h2>ทำไมมันผิด</h2>
  <div set:html={mdLite(d.why_wrong)} />

  <h2>ตัวอย่าง</h2>
  {examples.map((ex) => (
    <div class="card">
      <div class="lvl">{LEVEL_TH[ex.level]}</div>
      <blockquote style="margin-top:6px">{ex.text}</blockquote>
      {ex.note && <div class="sub" style="margin-top:6px">{ex.note}</div>}
    </div>
  ))}

  {d.not_fallacy.length > 0 && (
    <>
      <h2>กรณีที่คล้ายกันแต่ไม่ผิด</h2>
      <p class="sub" style="margin-top:0">
        ส่วนนี้สำคัญเท่ากับตัวตรรกวิบัติ เพราะรูปแบบเหล่านี้หลายอันเป็นเหตุผลที่ใช้ได้จริงในบางบริบท
      </p>
      {d.not_fallacy.map((nf) => (
        <div class="card">
          <blockquote>{nf.text}</blockquote>
          <div style="margin-top:6px"><span class="ok">ใช้ได้เพราะ</span> {nf.why_ok}</div>
        </div>
      ))}
    </>
  )}

  {d.responses.length > 0 && (
    <>
      <h2>คำถามที่ใช้ตอบกลับ</h2>
      <ul>{d.responses.map((r) => <li>{r}</li>)}</ul>
    </>
  )}

  {(confused.length > 0 || related.length > 0) && (
    <>
      <h2>รายการใกล้เคียง</h2>
      {confused.length > 0 && (
        <>
          <h3>มักสับสนกับ</h3>
          <ul class="plain">
            {confused.map((f) => (
              <li>
                <a href={url(`fallacy/${f.id}`)}>{f.data.name_th}</a>
                <span class="en"> — {f.data.one_liner}</span>
                <div>
                  <a href={url(`compare/${[entry.id, f.id].sort().join('--')}`)} class="sub">
                    เทียบสองอันนี้ทีละข้อ
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </>
      )}
      {related.length > 0 && (
        <>
          <h3>เกี่ยวข้อง</h3>
          <ul class="plain">
            {related.map((f) => (
              <li>
                <a href={url(`fallacy/${f.id}`)}>{f.data.name_th}</a>
                <span class="en"> — {f.data.one_liner}</span>
              </li>
            ))}
          </ul>
        </>
      )}
    </>
  )}

  {linkedCases.length > 0 && (
    <>
      <h2>เคสจริงที่เข้าข่ายนี้</h2>
      {linkedCases.map((c) => {
        const hit = c.data.fallacies.find((f) => f.slug.id === entry.id)!;
        return (
          <div class="card">
            <a href={url(`case/${c.id}`)} style="font-weight:500">{c.data.title_th}</a>
            <div class="sub">{c.data.source.outlet} · {thDate(c.data.date_of_statement)}</div>
            <blockquote style="margin-top:8px">{c.data.quote}</blockquote>
            <div style="margin-top:8px">{hit.analysis}</div>
            <div style="margin-top:6px">
              <span class="tag">
                {hit.confidence === 'clear' ? 'ชัดเจน' : 'ยังเถียงได้'}
              </span>
            </div>
          </div>
        );
      })}
    </>
  )}

  <div style="margin-top:28px">
    <Content />
  </div>

  <h2>อ้างอิง</h2>
  <ul class="plain">
    {d.sources.map((s) => (
      <li>
        {s.url ? <a href={s.url}>{s.title}</a> : s.title}
        {s.author && <span class="en"> — {s.author}</span>}
        {s.locator && <span class="en"> ({s.locator})</span>}
      </li>
    ))}
  </ul>
  <p class="sub">ปรับปรุงล่าสุด {thDate(d.updated)}</p>
</Base>
